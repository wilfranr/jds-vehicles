# Variables de producción (F6-02). Copia este archivo al SERVIDOR como `.env.prod`, rellénalo y protégelo:
#   chmod 600 .env.prod        (fuera del repositorio; nunca se versiona)
# Los valores de ejemplo NO son secretos reales. Genera los secretos con `openssl rand -base64 32`.
# La aplicación valida este entorno al arrancar (src/server/env.ts) y no arranca si algo es débil o falta.

# --- Base de datos (MySQL en la red interna de Docker; sin puerto publicado) ---------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=jds_vehiculos
MYSQL_USER=jds
MYSQL_PASSWORD=
# El servidor de BD se llama `db` dentro de la red de Compose. Si la contraseña tiene caracteres especiales,
# codifícalos (URL-encoding) o usa solo letras y números.
DATABASE_URL=mysql://jds:CAMBIAR_POR_MYSQL_PASSWORD@db:3306/jds_vehiculos

# --- Autenticación y proxy ------------------------------------------------------------------------------------------
# Al menos 32 caracteres, aleatorio.
AUTH_SECRET=
AUTH_TRUST_HOST=true
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# --- Sitio ------------------------------------------------------------------------------------------------------------
# Se incrusta en el código al COMPILAR la imagen (cambiarlo exige reconstruirla). En producción debe ser https.
NEXT_PUBLIC_SITE_URL=https://CAMBIAR_POR_IP_O_DOMINIO
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Operación --------------------------------------------------------------------------------------------------------
UPLOADS_DIR=/data/uploads
LOG_LEVEL=info
HEALTH_MIN_FREE_MB=200
# Horas de vigencia de una reserva (vacío = 48 h; 0 = no expiran). TODO(owner): confirmar el plazo.
RESERVA_EXPIRACION_HORAS=
# Respaldos (carpeta dentro del contenedor `tools`, volumen jds_backups) y copias conservadas.
BACKUP_DIR=/backups
BACKUP_RETENTION=14
