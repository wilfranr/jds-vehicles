# Database connection (Prisma / MySQL)
# Nota: Puerto 3307 por defecto para evitar colisión con MySQL/MariaDB del sistema host
DB_PORT=3307
DATABASE_URL="mysql://jds:jds@localhost:3307/jds_vehiculos"

# Authentication secret (Auth.js / NextAuth - Fase 2)
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public fallback WhatsApp contact number
# Nota: La fuente de verdad en producción será la tabla `configuracion_concesionario`.
NEXT_PUBLIC_WHATSAPP_NUMBER="573202353168"
