# Database connection (Prisma / MySQL)
# Nota: Puerto 3307 por defecto para evitar colisión con MySQL/MariaDB del sistema host
DB_PORT=3307
DATABASE_URL="mysql://jds:jds@localhost:3307/jds_vehiculos"

# Authentication secret (Auth.js - Fase 2). Obligatoria en producción: el servidor no arranca sin ella.
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# Auth.js detrás de un proxy inverso (servidor Oracle): confiar en las cabeceras X-Forwarded-*.
# En desarrollo no hace falta.
AUTH_TRUST_HOST=

# Limitación de intentos (F2-04): detrás de un proxy inverso, confiar en X-Forwarded-For.
# TRUST_PROXY_HOPS = número de proxies de confianza delante de la app (por defecto 1).
# Sin TRUST_PROXY=true todos los clientes comparten el mismo cupo (valor fijo).
TRUST_PROXY=
TRUST_PROXY_HOPS=

# Reservas (F3-01): horas de vigencia de una reserva (entero positivo). Vacía = 48 horas (valor por defecto del demo).
# 0 = las reservas no expiran. TODO(owner): confirmar el plazo antes de producción. Un valor inválido impide arrancar.
RESERVA_EXPIRACION_HORAS=

# Fotos de vehículos subidas desde el panel (F4-04): carpeta en el DISCO del servidor, fuera de `public/`.
# Por defecto ./uploads (ignorada por git). Debe existir con permisos de escritura para el usuario que ejecuta
# la app y estar incluida en las copias de seguridad.
UPLOADS_DIR=

# Registro de eventos (F5-03): debug | info | warn | error (por defecto info). Una línea JSON por evento en stdout.
LOG_LEVEL=

# Salud (F5-03): espacio libre mínimo en la carpeta de subidas, en MB, para que /api/health responda 200 (por defecto 200).
HEALTH_MIN_FREE_MB=

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public fallback WhatsApp contact number
# Nota: La fuente de verdad en producción será la tabla `configuracion_concesionario`.
NEXT_PUBLIC_WHATSAPP_NUMBER="573202353168"

# Seed passwords (opcionales para entorno local; si no se definen usan valores por defecto)
SEED_ADMIN_PASSWORD="Admin123*"
SEED_CLIENT_PASSWORD="Cliente123*"

# --- Producción (el servidor se niega a arrancar si falta algo; los valores no se imprimen) ---
# AUTH_SECRET >= 32 caracteres, AUTH_TRUST_HOST=true, TRUST_PROXY=true, UPLOADS_DIR absoluta y escribible,
# NEXT_PUBLIC_SITE_URL con https y DATABASE_URL de la base real.
