# Variables del proxy (F6-03): añádelas al archivo de entorno del servidor (.env.prod, chmod 600).
# Sin valores reales en el repositorio.

# Modo IP (ahora): la IP pública del servidor. Modo dominio (después): el dominio, p. ej. www.ejemplo.com.
SITE_ADDRESS=CAMBIAR_POR_IP_O_DOMINIO
# internal = certificado de la CA interna de Caddy (IP) · acme = certificado público de Let's Encrypt (dominio).
TLS_MODE=internal
# Strict-Transport-Security: off en modo IP; on solo con dominio y certificado público.
HSTS=off
# Puerto del host (el 443 está libre; el 80 es de otra aplicación y NO se usa). Solo para pruebas: 8443, etc.
HTTPS_PORT=443
# Interfaz de escucha (0.0.0.0 = todas; 127.0.0.1 solo para pruebas locales).
HTTPS_BIND=0.0.0.0
